EXPO_PUBLIC_GRADING_MODE=api
# wifi works in Expo Go; real selects native BLE; mock needs no hardware.
EXPO_PUBLIC_SENSOR_MODE=wifi
EXPO_PUBLIC_SENSOR_WIFI_URL=http://192.168.10.126
# Backend only: Azure HTTPS or a laptop LAN base URL. Restart Expo after changing.
# The ESP32 URL above remains local and independent.
EXPO_PUBLIC_API_URL=https://cinnai.wittymushroom-238da769.centralindia.azurecontainerapps.io


# Firebase Console > Project settings > Your apps > Web app SDK config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Native Google sign-in (development build only)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Enable only AFTER the cloud API and migrations are deployed.
EXPO_PUBLIC_CLOUD_STORAGE_ENABLED=false
# Set EXPO_PUBLIC_SENSOR_MODE=cloud for internet telemetry; wifi keeps local fallback.
