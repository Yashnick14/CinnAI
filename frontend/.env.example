EXPO_PUBLIC_GRADING_MODE=api
# wifi works in Expo Go; real selects native BLE; mock needs no hardware.
EXPO_PUBLIC_SENSOR_MODE=wifi
EXPO_PUBLIC_SENSOR_WIFI_URL=http://192.168.10.126
# Visual requests always use /predict-visual. Use your computer's LAN IP, not localhost.
# Replace this example with your laptop's current Wi-Fi IPv4 address, then restart Expo.
EXPO_PUBLIC_API_URL=http://192.168.10.149:8000


# Firebase Console > Project settings > Your apps > Web app SDK config
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Native Google sign-in (development build only)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=
