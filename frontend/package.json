{
  "name": "cinnamon-hybrid-grading",
  "version": "0.1.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "eas:link": "node scripts/configure-eas-project.mjs",
    "start": "expo start --dev-client",
    "go": "expo start --go",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "export:ios": "expo export --platform ios",
    "web": "expo start --web",
    "styles:build": "tailwindcss -i ./src/styles/tailwind.css -o ./src/styles/generated.css --minify",
    "styles:watch": "tailwindcss -i ./src/styles/tailwind.css -o ./src/styles/generated.css --watch",
    "preweb": "npm run styles:build",
    "export:web": "npm run styles:build && expo export --platform web"
  },
  "dependencies": {
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo/metro-runtime": "~57.0.16",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-google-signin/google-signin": "^16.1.5",
    "@react-navigation/native": "^7.5.0",
    "@react-navigation/native-stack": "^7.20.0",
    "base-64": "^1.0.0",
    "expo": "^57.0.0",
    "expo-camera": "~57.0.6",
    "expo-constants": "~57.0.3",
    "expo-crypto": "~57.0.4",
    "expo-dev-client": "~57.0.20",
    "expo-file-system": "~57.0.7",
    "expo-font": "^57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-video": "~57.0.5",
    "firebase": "12.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-ble-plx": "^3.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "@types/base-64": "^1.0.2",
    "@types/react": "~19.2.10",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vitest": "^3.2.7"
  }
}
