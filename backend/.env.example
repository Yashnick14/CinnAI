DATABASE_URL=postgresql+psycopg://cinnamon:cinnamon@localhost:5432/cinnamon_grading
UPLOAD_DIRECTORY=./data/grading-images
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
MAX_IMAGE_BYTES=10485760
# Local debug originals are retained even when quill detection fails; delete manually when finished.
TEMP_VISUAL_UPLOAD_DIRECTORY=./data/temporary-visual-uploads

# Cinnamon assistant (never commit a real key).
GEMINI_API_KEY=

# Opt-in cloud routes; credentials supplied at runtime from Key Vault.
CLOUD_STORAGE_ENABLED=false
FIREBASE_PROJECT_ID=cinnai-7f4af
# CLOUD_DATABASE_URL=postgresql+psycopg://<app-role>:<url-encoded-password>@<host>/cinnai?sslmode=verify-full&sslrootcert=/etc/ssl/certs/ca-certificates.crt
