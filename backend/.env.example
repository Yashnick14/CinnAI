DATABASE_URL=postgresql+psycopg://cinnamon:cinnamon@localhost:5432/cinnamon_grading
UPLOAD_DIRECTORY=./data/grading-images
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:8082
MAX_IMAGE_BYTES=10485760
# Local debug originals are retained even when quill detection fails; delete manually when finished.
TEMP_VISUAL_UPLOAD_DIRECTORY=./data/temporary-visual-uploads

# Cinnamon assistant.
GEMINI_API_KEY=

# Opt-in cloud routes; credentials supplied at runtime from Key Vault.
CLOUD_STORAGE_ENABLED=false
FIREBASE_PROJECT_ID=
# Runtime PostgreSQL DSN; use verify-full TLS and a CA file valid on this OS.
# Azure supplies this securely through Key Vault. Leave blank when cloud storage is disabled.
CLOUD_DATABASE_URL=

# Active model and writable cache/output paths (relative to backend unless absolute).
MODEL_DIRECTORY=./models
ASSISTANT_ENCODER_PATH=sentence-transformers/all-MiniLM-L6-v2
ASSISTANT_ENCODER_CACHE=./data/assistant-encoder
V5_COLLECTION_DIRECTORY=./backend_handoff/realworld_v5_collection
