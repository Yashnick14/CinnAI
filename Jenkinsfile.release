// Protected main-only Pipeline job. No SCM/timer triggers.
pipeline {
 agent { label 'cinnai-release-linux' }
 options { skipDefaultCheckout(true); disableConcurrentBuilds(); buildDiscarder(logRotator(numToKeepStr:'10', artifactNumToKeepStr:'5'));  disableRestartFromStage(); timeout(time:180, unit:'MINUTES') }
 parameters {
  string(name:'COMMIT_SHA', defaultValue:'', description:'Exact pushed main commit')
  choice(name:'ACTION', choices:['deploy','rollback'], description:'Manual release action')
 }
 stages {
  stage('Main checkout') {
   steps {
    script {
     if (!currentBuild.getBuildCauses('hudson.model.Cause$UserIdCause')) { error('Authenticated manual trigger required') }
     if (!(params.COMMIT_SHA ==~ /[0-9a-f]{40}/)) { error('Full SHA required') }
    }
    deleteDir()
    checkout scm
    sh 'rm -f release-result.json .ci-tested-image.txt'
    withCredentials([gitUsernamePassword(credentialsId:'cinnai-github-read', gitToolName:'Default')]) {
     sh 'test "$(git rev-parse HEAD)" = "$COMMIT_SHA" && test "$(git ls-remote origin refs/heads/main | cut -f1)" = "$COMMIT_SHA"'
    }
    script { env.BRANCH_NAME='main'; env.VALIDATED_COMMIT=params.COMMIT_SHA }
   }
  }
  stage('Required validation') {
   when { expression { params.ACTION == 'deploy' } }
   steps { lock(resource:'cinnai-local-docker-validation') { pwsh '& ./infrastructure/jenkins/validate.ps1' } }
  }
  stage('Image release') {
   steps {
    lock(resource:'cinnai-production') {
     withCredentials([
      gitUsernamePassword(credentialsId:'cinnai-github-read', gitToolName:'Default'),
      string(credentialsId:'cinnai-release-client-id', variable:'AZURE_CLIENT_ID'),
      string(credentialsId:'cinnai-release-tenant-id', variable:'AZURE_TENANT_ID'),
      file(credentialsId:'cinnai-release-certificate', variable:'AZURE_CERTIFICATE')
     ]) {
      sh '''
       set +x
       export AZURE_CONFIG_DIR="$(mktemp -d)"
       export DOCKER_CONFIG="$(mktemp -d)"
       trap 'rm -rf "$AZURE_CONFIG_DIR" "$DOCKER_CONFIG"' EXIT
       az login --service-principal --username "$AZURE_CLIENT_ID" --certificate "$AZURE_CERTIFICATE" --tenant "$AZURE_TENANT_ID" --output none
       az account set --subscription 666a8489-014b-456e-8d3a-3b531503b1b3
       pwsh -NoProfile -File infrastructure/jenkins/image-release.ps1 -Action "$ACTION"
      '''
     }
    }
   }
  }
 }
 post { always { archiveArtifacts artifacts:'release-result.json,.ci-reports/**', allowEmptyArchive:true; pwsh '& ./infrastructure/jenkins/cleanup-cache.ps1' } }
}
